# --- Required ---
# OpenRouter is the ONLY LLM/embedding provider this system calls. It is
# usage-billed by design (that's the point — cost-aware model routing), so
# it's the one paid dependency that isn't optional. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Everything below is OPTIONAL. Every one of these is a paid/hosted ---
# --- service with a free, open-source fallback wired in automatically  ---
# --- when its key is left unset. Set a key only if you want that      ---
# --- specific paid upgrade; the system runs fully without any of them. ---

# [PAID — Firecrawl] Clean crawl + markdown extraction. https://firecrawl.dev
# Unset -> falls back to a built-in, open-source fetch+cheerio crawler
# (backend/src/crawl/fallbackCrawler.ts). No functionality is disabled,
# just less clean extraction on heavily client-rendered sites.
FIRECRAWL_API_KEY=

# [PAID — Google Cloud] Real Core Web Vitals via the PageSpeed Insights API.
# https://developers.google.com/speed/docs/insights/v5/get-started
# Unset -> falls back to a REAL local Lighthouse run on Puppeteer's bundled,
# open-source Chromium (backend/src/audit/localLighthouse.ts) — not a fake
# heuristic, actual Lighthouse scoring, just self-hosted instead of Google's
# API. Only if that also fails (no headless-browser support at all in the
# deploy target) does it drop to a page-weight heuristic. See
# DISABLE_LOCAL_LIGHTHOUSE and CHROMIUM_EXECUTABLE_PATH below.
PAGESPEED_API_KEY=

# [free, but a hosted third-party service] GitHub PR delivery for the coding
# agent. GitHub's API itself has no charge; you're only providing a token.
# Needs repo scope (or fine-grained contents+pull-requests) on the target repo.
# Unset -> POST /audits/:id/apply writes the same generated fix files to a
# local patch directory (DATA_DIR/patches/<runId>/) instead of opening a PR.
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# --- Local Lighthouse tuning (open source, no key required) ---
# Override the Chromium binary Puppeteer/Lighthouse launches (e.g. a system
# Chromium installed via the Railway/nixpacks build — see nixpacks.toml).
# Leave unset locally: Puppeteer downloads its own pinned Chromium at
# `npm install` time and that's used by default.
CHROMIUM_EXECUTABLE_PATH=
# Set true to skip local Lighthouse entirely (e.g. a deploy target known to
# have no headless-browser support) and go straight to the page-weight
# heuristic instead of paying the Chromium-launch cost on every run.
DISABLE_LOCAL_LIGHTHOUSE=false

# --- Server ---
PORT=8787
DATA_DIR=./data

# --- Model routing (OpenRouter model ids). Override per-tier to tune cost/quality. ---
# Cheap: extraction, routine technical checks, classification.
OPENROUTER_MODEL_CHEAP=google/gemini-2.5-flash-lite
# Mid: on-page/content reasoning, E-E-A-T, GEO/AEO analysis.
OPENROUTER_MODEL_MID=anthropic/claude-haiku-4.5
# Strong: final synthesis/prioritization and code generation.
OPENROUTER_MODEL_STRONG=anthropic/claude-sonnet-4.5
# Embeddings for the company-doc RAG store.
OPENROUTER_MODEL_EMBED=openai/text-embedding-3-small

# Optional hard ceiling on estimated spend per audit run, in USD. 0 = no ceiling.
COST_CEILING_USD=2.00

# Attributed via OpenRouter's recommended headers.
OPENROUTER_SITE_URL=https://github.com/xsentry-labs/emory
OPENROUTER_SITE_NAME=Emory Audit

# --- Beacon Phase B1: AI visibility + continuous re-audit ---
# See ../BEACON_ARCHITECTURE.md. No new paid dependency — both features run
# entirely on the OpenRouter key above.

# Comma-separated OpenRouter model ids checked for AI visibility (does the
# model mention the brand when asked a buying question?). Deliberately mixes
# model families — that's the point of this check, not a cost decision.
AI_VISIBILITY_MODELS=openai/gpt-4o-mini,google/gemini-2.5-flash,anthropic/claude-haiku-4.5

# Comma-separated site URLs to re-audit on a schedule. Empty (default) means
# the scheduler doesn't start at all — this is opt-in, no behavior change for
# an Audit-only deployment.
BEACON_TARGET_URLS=
# Standard 5-field cron expression, evaluated in the server's local time.
# Default: daily at 3am.
BEACON_REAUDIT_CRON=0 3 * * *

# Rate limit for POST /audits (the expensive endpoint). Default 20/hour/client.
RATE_LIMIT_AUDITS_PER_HOUR=20

# Comma-separated allowlist of origins allowed to call this API. Unset (the
# default) is wide open — fine for local development, lock this down before
# exposing the service publicly.
CORS_ORIGIN=
