{
  "name": "emory-audit-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SEO + GEO/AEO audit and coding-agent backend for Emory Audit. OpenRouter-only LLM calls, human-approval gate, GitHub PR delivery.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:cli": "tsx src/cli/runAudit.ts"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^1.11.1",
    "@octokit/rest": "^21.0.2",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "fast-xml-parser": "^4.5.0",
    "lighthouse": "^12.2.1",
    "nanoid": "^5.0.7",
    "node-fetch": "^3.3.2",
    "openai": "^4.68.4",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "puppeteer": "^23.9.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
