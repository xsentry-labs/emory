# Required. Random string that signs login cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Required to allow sign-ups: share this code with the people you invite.
INVITE_CODE=
# Optional: max model-spending actions per workspace per UTC day.
# LIMIT_HUNTS_PER_DAY=3
# LIMIT_ONBOARDING_PER_DAY=5
# LIMIT_AI_ACTIONS_PER_DAY=40
# Optional: the ONE workspace allowed to use the server's SMTP/IMAP mailbox (below).
# Other workspaces copy approved drafts into their own mail app.
# SENDING_WORKSPACE_ID=1
# Where SQLite lives. On Railway, mount the volume at /data.
DATA_DIR=./data
# Seconds between background worker ticks (follow-up scheduling).
WORKER_INTERVAL_SECONDS=60

# LLM drafting via OpenRouter (https://openrouter.ai). Optional; drafting is disabled without a key.
OPENROUTER_API_KEY=
# Any OpenRouter model id.
OPENROUTER_MODEL=openai/gpt-6-luna

# Sending approved emails (SMTP). Sending is off unless both SMTP_URL and FROM_EMAIL are set.
# SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
FROM_EMAIL=
FROM_NAME=
# Appended to every email: your postal address and an opt-out line (use \n for line breaks).
EMAIL_FOOTER=
# Max emails sent in any rolling 24 hours.
SEND_DAILY_CAP=30

# Reading replies (IMAP). Off unless IMAP_HOST, IMAP_USER and IMAP_PASS are set.
# Use the mailbox your outreach is sent from (replies land there).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_POLL_SECONDS=120

# Plans. New workspaces start on this plan: free | starter | growth | scale.
# For a pilot, set growth so limits don't get in the way.
DEFAULT_PLAN=free
# Comma-separated emails allowed to open /admin and change plans.
ADMIN_EMAILS=
# Where paid-plan buttons on the pricing page send people (an email address).
CONTACT_EMAIL=
